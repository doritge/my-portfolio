---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function getThumbnail(slug: string, thumbnail?: string): string | null {
  const thumbDir = path.join(process.cwd(), 'public', 'images', 'blog', 'thumb');
  const id = thumbnail ?? slug;
  for (const ext of ['.png', '.jpg', '.jpeg', '.webp']) {
    if (fs.existsSync(path.join(thumbDir, `${id}${ext}`))) {
      return `/images/blog/thumb/${id}${ext}`;
    }
  }
  return null;
}

// The article header image: a dedicated `cover` image living alongside the
// article's inline images, falling back to the list thumbnail if not set.
function getCoverImage(slug: string, cover?: string, thumbnail?: string): string | null {
  if (cover) {
    const dir = path.join(process.cwd(), 'public', 'images', 'blog', slug);
    for (const ext of ['.png', '.jpg', '.jpeg', '.webp']) {
      if (fs.existsSync(path.join(dir, `${cover}${ext}`))) {
        return `/images/blog/${slug}/${cover}${ext}`;
      }
    }
  }
  return getThumbnail(slug, thumbnail);
}

const cover = getCoverImage(post.id, post.data.cover, post.data.thumbnail);
---

<BaseLayout title={`${post.data.title} — Blog — emergence`}>
  <article class="post">
    <a href="/blog" class="back">&larr; Blog</a>
    <h1>{post.data.title}</h1>
    {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
    {cover && (
      <div class="thumb">
        <img src={cover} alt={post.data.title} />
      </div>
    )}
    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 680px;
    margin: 3rem auto 4rem;
    padding: 0 2rem;
  }

  .back {
    display: inline-block;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: #999;
    text-decoration: none;
    margin-bottom: 2rem;
  }

  .back:hover {
    color: #444;
  }

  h1 {
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #111;
    margin-bottom: 0.4rem;
  }

  .subtitle {
    margin-top: 0.4rem;
    font-size: 1.05rem;
    line-height: 1.75;
    font-style: italic;
    color: #666;
    margin-bottom: 2rem;
  }

  .thumb {
    width: 100%;
    background: #f5f5f5;
    margin-bottom: 2rem;
  }

  .thumb img {
    width: 100%;
    height: auto;
  }

  .content {
    font-size: 1.05rem;
    line-height: 1.9;
    color: #333;
  }

  .content :global(p) {
    margin-bottom: 1.5rem;
  }

  .content :global(h2) {
    font-size: 1.3rem;
    font-weight: 500;
    color: #111;
    margin: 2.5rem 0 1rem;
  }

  .content :global(a) {
    color: #111;
    text-decoration: underline;
  }

  .content :global(figure) {
    margin: 2rem 0;
  }

  .content :global(figure img) {
    width: 100%;
    height: auto;
    margin: 0;
  }

  .content :global(img) {
    width: 100%;
    height: auto;
    margin: 2rem 0;
  }

  .content :global(figcaption) {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #999;
    text-align: center;
  }
</style>
