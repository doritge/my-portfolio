---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getThumbnail(slug: string, thumbnail?: string): string | null {
  const thumbDir = path.join(process.cwd(), 'public', 'images', 'blog', 'thumb');
  const id = thumbnail ?? slug;
  for (const ext of ['.png', '.jpg', '.jpeg', '.webp']) {
    if (fs.existsSync(path.join(thumbDir, `${id}${ext}`))) {
      return `/images/blog/thumb/${id}${ext}`;
    }
  }
  return null;
}
---

<BaseLayout title="Blog — emergence">
  <div class="blog">
    <h1>Reflecting on technology and philosophy</h1>
    <ul class="posts">
      {posts.map((post) => {
        const thumb = getThumbnail(post.id, post.data.thumbnail);
        return (
          <li>
            <a href={`/blog/${post.id}`} class="post">
              <div class="thumb">
                {thumb && <img src={thumb} alt={post.data.title} loading="lazy" />}
              </div>
              <div class="text">
                <h2 class="title">{post.data.title}</h2>
                {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
                <p class="description">{post.data.description}</p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
    {posts.length === 0 && <p class="empty">No articles yet.</p>}
  </div>
</BaseLayout>

<style>
  .blog {
    max-width: 760px;
    margin: 3rem auto 2rem;
    padding: 0 2rem;
  }

  h1 {
    font-size: 1.4rem;
    font-weight: 500;
    font-style: italic;
    letter-spacing: 0.01em;
    margin-bottom: 2.5rem;
  }

  .posts {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post {
    display: flex;
    gap: 1.5rem;
    text-decoration: none;
    color: inherit;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e8e8e8;
  }

  .posts li:last-child .post {
    border-bottom: none;
  }

  .thumb {
    flex: 0 0 140px;
    width: 140px;
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post:hover .thumb img {
    opacity: 0.85;
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 500;
    color: #111;
    margin-bottom: 0.3rem;
  }

  .subtitle {
    font-size: 0.9rem;
    font-style: italic;
    color: #666;
    margin-bottom: 0.6rem;
  }

  .description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #444;
  }

  @media (max-width: 600px) {
    .thumb {
      flex-basis: 96px;
      width: 96px;
    }
  }

  .empty {
    color: #999;
    font-size: 0.9rem;
  }
</style>
