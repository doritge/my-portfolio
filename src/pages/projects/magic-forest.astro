---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import fs from 'node:fs';
import path from 'node:path';

const series = (await getCollection('projects')).find(s => s.id === 'magic-forest');
const { title, year, tagline, description } = series!.data;

const thumbDir = path.join(process.cwd(), 'public', 'images', 'magic-forest', 'thumb');
const printDir = path.join(process.cwd(), 'public', 'images', 'magic-forest', 'print');

function listImages(dir: string): string[] {
  try {
    return fs.readdirSync(dir)
      .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f))
      .sort();
  } catch {
    return [];
  }
}

function findFile(dir: string, id: string): string | undefined {
  for (const ext of ['.png', '.jpg', '.jpeg', '.webp']) {
    if (fs.existsSync(path.join(dir, `${id}${ext}`))) return `${id}${ext}`;
  }
}

const images = listImages(thumbDir).map(filename => {
  const id = filename.replace(/\.[^.]+$/, '');
  const printFile = findFile(printDir, id);
  return {
    id,
    thumb:   `/images/magic-forest/thumb/${filename}`,
    display: `/images/magic-forest/display/${filename}`,
    print:   printFile ? `/images/magic-forest/print/${printFile}` : undefined,
  };
});
---

<BaseLayout title={`${title} — emergence`}>
  <div class="series-layout">
    <div class="gallery">
      {images.map((img, i) => (
        <button
          class="thumb-btn"
          data-index={i}
          aria-label={`View ${img.id}`}
        >
          <img src={img.thumb} alt={img.id} loading="lazy" />
        </button>
      ))}
      {images.length === 0 && <p class="empty">No images yet.</p>}
    </div>

    <aside class="sidebar">
      <h1>{title}</h1>
      <span class="year">{year}</span>
      {tagline && <p class="description tagline">{tagline}</p>}
      <p class="description">{description}</p>
    </aside>
  </div>

  <Lightbox images={images.map(img => ({ id: img.id, display: img.display, print: img.print }))} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const index = Number(btn.dataset.index);
      document.dispatchEvent(new CustomEvent('open-lightbox', { detail: { index } }));
    });
  });
</script>

<style>
  .series-layout {
    display: grid;
    grid-template-columns: 1fr 14rem;
    gap: 3rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 2.5rem 6rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .series-layout {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem 4rem;
    }
    .sidebar {
      order: -1;
    }
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .thumb-btn {
    display: block;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 100%;
  }

  .thumb-btn img {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.15s;
  }

  .thumb-btn:hover img {
    opacity: 0.85;
  }

  .empty {
    color: #999;
    font-size: 0.9rem;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  h1 {
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #111;
  }

  .year {
    font-size: 1rem;
    color: #999;
    letter-spacing: 0.05em;
  }

  .description {
    margin-top: 1rem;
    font-size: 1.05rem;
    line-height: 1.75;
    color: #666;
  }

  .tagline {
    font-style: italic;
  }
</style>
